{
  "manifest_version": 3,
  "name": "网页图片全能抓取器",
  "version": "1.1.0",
  "description": "三层扫描当前网页任意格式图片（含懒加载、CSS 背景、srcset、动态加载、内联图），支持智能原图还原、预览筛选与本地保存。",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "storage",
    "webRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "抓取本页所有图片" },
  "minimum_chrome_version": "102"
}
