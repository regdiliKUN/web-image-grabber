{
  "manifest_version": 3,
  "name": "网页图片全能抓取器",
  "version": "1.0.0",
  "description": "抓取当前网页上任意格式的图片（含懒加载、CSS 背景、srcset、动态加载、内联图），保存到你指定的本地文件夹。",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "storage",
    "webRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "抓取本页所有图片" },
  "minimum_chrome_version": "102"
}
